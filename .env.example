# Copy to .env and fill in. Never commit .env.

# ---- ONE switch: which provider runs every LLM step ----
# azure | gemini | groq
LLM_PROVIDER=azure

# ---- Azure OpenAI / Foundry (used when LLM_PROVIDER=azure) ----
# Endpoint from the Foundry project, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Use the DEPLOYMENT names you chose in Foundry (not the model names)
AZURE_DEPLOYMENT_EXTRACT=gpt-4.1-mini
AZURE_DEPLOYMENT_ADAPT=gpt-5
# Deployment names (exact, comma-separated) that are reasoning models (they reject temperature)
AZURE_REASONING_DEPLOYMENTS=gpt-5
AZURE_REASONING_EFFORT=low

# ---- Gemini (used when LLM_PROVIDER=gemini). Free key: https://aistudio.google.com ----
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-3.6-flash
GEMINI_MODEL_ADAPT=gemini-3.6-flash

# ---- Groq (used when LLM_PROVIDER=groq). Free key: https://console.groq.com ----
GROQ_API_KEY=
GROQ_MODEL_EXTRACT=llama-3.3-70b-versatile
GROQ_MODEL_ADAPT=llama-3.3-70b-versatile

# ---- Images: ONE provider, no fallback ----
# azure       = gpt-image-* deployments (OpenAI Images API)
# azure_flux  = FLUX.2-pro / FLUX.2-flex (Black Forest Labs API on Foundry): set AZURE_FLUX_MODEL, optionally AZURE_FLUX_ENDPOINT
IMAGE_PROVIDER=azure
AZURE_FLUX_MODEL=FLUX.2-pro
AZURE_FLUX_ENDPOINT=
# The name you gave the image deployment in Foundry (tested with gpt-image-2). Uses the same endpoint and key as above.
AZURE_DEPLOYMENT_IMAGE=
# low | medium | high (low is fast and cheap for trial runs)
IMAGE_QUALITY=medium
# Set to "high" to make edits preserve faces from the reference images, if your deployment accepts it
IMAGE_INPUT_FIDELITY=
# 1 avoids rate limits on small tiers
IMAGE_CONCURRENCY=1

# ---- App ----
WORKSPACE_DIR=workspace
LLM_MAX_RETRIES=3
# How many independent scene calls run at once (extraction, scene plans, rewrite). 1 = sequential.
# Raise it if your quota allows; lower it if you see rate-limit (429) errors.
LLM_CONCURRENCY=3
LLM_REQUEST_TIMEOUT=60
# Largest upload accepted, in MB
MAX_UPLOAD_MB=10
