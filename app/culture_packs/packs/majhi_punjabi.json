  "style_rules": [
    {
      "id": "R1",
      "text": "Write in the selected output script. Use standard literary Punjabi as the base register, because Majhi is its basis. Do not introduce markers of Malwai, Doabi, Haryanvi or Rajasthani speech.",
      "fact_ids": [
        "F002",
        "F006"
      ]
    },
    {
      "id": "R2",
      "text": "Address elders by a relationship term plus 'ji', never by first name. Use the respectful 'tusi' for elders and strangers and 'tu' only for peers, younger people and intimacy.",
      "fact_ids": [
        "F012",
        "F016",
        "F028"
      ]
    },
    {
      "id": "R3",
      "text": "Use the specific paternal or maternal kinship term (Chacha, Taya, Mama, Masi...), not a generic 'uncle' or 'aunt'.",
      "fact_ids": [
        "F021",
        "F022",
        "F023"
      ]
    },
    {
