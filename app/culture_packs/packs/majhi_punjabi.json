    },
    {
      "id": "F004",
      "category": "dialect",
      "text": "'How?' is kivẽ / kiṉj in Majhi; Doabi uses kiddā̃. 'Like this' is ēvẽ / ēṉj in Majhi and ēdā̃ in Doabi.",
      "term": "ਕਿਵੇਂ",
      "roman": "kivẽ",
      "source_ids": [
        "S1"
      ],
      "basis": "page_read",
      "confidence": "medium",
      "uncertain": true,
      "note": "From a linguistic table. Everyday Punjabi commonly uses both kivẽ and kiddā̃, so do not treat kiddā̃ as an error. Weak marker only.",
      "crosschecks": [
        {
          "model": "azure:gpt-5",
          "verdict": "agree",
          "note": "ਕਿਵੇਂ (kivẽ) spelling and meaning correct."
        },
        {
          "model": "gemini:gemini-3.5-flash",
          "verdict": "agree",
          "note": ""
        }
      ]
    },
    {
