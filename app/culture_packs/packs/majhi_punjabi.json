    {
      "id": "F002",
      "category": "dialect",
      "text": "Majhi is the basis of the standard register of Punjabi, used in textbooks, formal writing and broadcasting.",
      "term": "",
      "roman": "",
      "source_ids": [
        "S1",
        "S2",
        "S3"
      ],
      "basis": "page_read",
      "confidence": "high",
      "uncertain": false,
      "note": "Standard literary Punjabi is therefore a reasonable base register. Spoken village Majhi has additional local features.",
      "crosschecks": [
        {
          "model": "azure:gpt-5",
          "verdict": "agree",
          "note": ""
        },
        {
          "model": "gemini:gemini-3.5-flash",
          "verdict": "agree",
          "note": ""
        }
      ]
    },
    {
      "id": "F003",
      "category": "dialect",
      "text": "Majhi is transitional between the Eastern and Western Punjabi dialects.",
